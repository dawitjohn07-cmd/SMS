# Local environment files and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/auth.json

# Dependency directories
**/node_modules/
**/vendor/

# Angular generated files
/frontend/.angular/
/frontend/dist/
/frontend/coverage/

# Laravel generated files and local data
/backend/bootstrap/cache/*.php
/backend/public/build/
/backend/public/hot
/backend/storage/*.key
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/storage/framework/cache/data/*
!/backend/storage/framework/cache/data/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/database/*.sqlite
/backend/database/*.sqlite3
/backend/.phpunit.cache/
/backend/.phpunit.result.cache

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# Editor and operating system files
.idea/
.DS_Store
Thumbs.db
desktop.ini
